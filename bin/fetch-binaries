#!/usr/bin/env ruby
# frozen_string_literal: true

# Downloads the mcptask_runner release archives matching the gem version from
# jchsoft/mcptask-releases, verifies each against checksums.txt and stages the
# binaries under tmp/binaries/<goos>_<goarch>/ for `rake package:all`.
#
# Usage: bin/fetch-binaries [version]   (defaults to McptaskRailsRunner::VERSION)
#
# MCPTASK_WAIT_FOR_RELEASE=<seconds> keeps waiting for a release that is still
# being published, instead of failing on the first 404.

require "open-uri"
require "digest"
require "fileutils"
require_relative "../lib/mcptask_rails_runner/version"

version = ARGV.fetch(0, McptaskRailsRunner::VERSION).delete_prefix("v")
repo = ENV.fetch("MCPTASK_RELEASE_REPO", "jchsoft/mcptask-releases")
base = "https://github.com/#{repo}/releases/download/v#{version}"

TARGETS = [
  %w[darwin arm64 tar.gz],
  %w[darwin amd64 tar.gz],
  %w[linux arm64 tar.gz],
  %w[linux amd64 tar.gz],
  %w[windows amd64 zip]
].freeze

# How long to keep waiting for a release that is still being published.
#
# 0, the default, fails on the first 404 — which is what somebody running this
# by hand against a version they mistyped wants. The release workflow passes a
# real deadline, because the two tags are pushed by hand minutes apart and the
# binaries only exist once goreleaser has finished: v0.3.0's gem release started
# three minutes before its binaries appeared, failed on this very download, and
# had to be re-run. The Go release takes about 215s, so the default below is
# roughly four times what it needs.
WAIT_SECONDS = Integer(ENV.fetch("MCPTASK_WAIT_FOR_RELEASE", "0"))
POLL_SECONDS = 15

# One deadline for the whole run rather than one per download: six full-length
# waits would be a job hanging for an hour and a half over a release that is
# never coming.
DEADLINE = Time.now + WAIT_SECONDS

def fetch(url)
  announced = false
  loop do
    return URI.parse(url).open("rb", &:read) # OpenURI follows GitHub's redirect to the CDN
  rescue OpenURI::HTTPError => e
    # Only a file that is not there yet is worth waiting on. A 401 or a 403 will
    # not fix itself, and neither will a URL that is simply wrong.
    unpublished = e.message.include?("404") && Time.now < DEADLINE
    abort "download failed: #{url} (#{e.message})" unless unpublished

    unless announced
      puts "  #{File.basename(url)} is not published yet — waiting up to #{(DEADLINE - Time.now).round}s"
      announced = true
    end
    sleep POLL_SECONDS
  end
end

puts "fetching v#{version} artifacts from #{repo}"
checksums = fetch("#{base}/checksums.txt").lines.to_h { |l| l.split.reverse.first(2) }

TARGETS.each do |goos, goarch, ext|
  archive = "mcptask_runner_#{version}_#{goos}_#{goarch}.#{ext}"
  data = fetch("#{base}/#{archive}")

  expected = checksums.fetch(archive) { abort "#{archive} missing from checksums.txt" }
  actual = Digest::SHA256.hexdigest(data)
  abort "checksum mismatch for #{archive}: expected #{expected}, got #{actual}" unless actual == expected

  dir = File.join("tmp/binaries", "#{goos}_#{goarch}")
  FileUtils.rm_rf(dir)
  FileUtils.mkdir_p(dir)
  archive_path = File.join(dir, archive)
  File.binwrite(archive_path, data)

  ok = if ext == "zip"
         system("unzip", "-oq", archive_path, "-d", dir)
       else
         system("tar", "-xzf", archive_path, "-C", dir)
       end
  abort "extraction failed for #{archive}" unless ok
  FileUtils.rm_f(archive_path)

  exe = goos == "windows" ? "mcptask_runner.exe" : "mcptask_runner"
  abort "#{exe} not found inside #{archive}" unless File.file?(File.join(dir, exe))
  puts "  staged #{dir}/#{exe} (sha256 ok)"
end

puts "done — run `rake package:all`"
